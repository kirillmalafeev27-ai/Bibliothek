{
  "name": "der-blinde-bibliothekar",
  "version": "0.1.0",
  "private": true,
  "description": "«Слепой библиотекарь» (Der blinde Bibliothekar) — игра-стелс для изучения немецкого",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
